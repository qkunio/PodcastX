{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "lib": ["ES2022", "DOM"],
    "outDir": "dist-ts",
    "rootDir": "."
  },
  "include": ["src/**/*", "scripts/**/*", "render.ts"],
  "exclude": ["node_modules", "dist"]
}
